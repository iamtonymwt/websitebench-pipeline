{
  "schema_version": "websitebench.generic-public-clone-deployment.v2",
  "source_dir": "materials/home-depot/clone",
  "backend_runtime": "materials/home-depot/backend/runtime.json",
  "deployment_profile": "cloudflare-review",
  "runtime": {
    "command": [
      "python",
      "-m",
      "uvicorn",
      "app:app",
      "--host",
      "0.0.0.0",
      "--port",
      "10000",
      "--log-level",
      "warning"
    ],
    "port": 10000,
    "health_path": "/healthz",
    "python_requirements": [
      "fastapi==0.141.1",
      "uvicorn==0.52.3"
    ],
    "support_paths": []
  },
  "cloudflare": {
    "worker_name": "websitebench-home-depot-demo",
    "compatibility_date": "2026-08-14",
    "instance_type": "basic",
    "max_instances": 1
  }
}
